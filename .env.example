# Copy to .env and fill in. .env is git-ignored - never commit real keys.

# OWASP ZAP API (the docker-compose lab runs ZAP on :8080)
ZAP_BASE_URL=http://localhost:8080
ZAP_API_KEY=change-me

# Target under test. ZAP reaches Benchmark by service name inside the network.
TARGET_URL=http://benchmark:8080/benchmark/

# Optional LLM for the MCP triage assistant: none | ollama | openai | anthropic
LLM_PROVIDER=none
LLM_API_KEY=
